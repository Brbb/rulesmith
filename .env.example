# Optional OpenAI-compatible chat-completions provider. Never use NEXT_PUBLIC_ for a key.
# Export these variables in the shell that starts the Go API.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Optional Next.js proxy destination; set when starting/building the web app.
POLICY_API_URL=http://127.0.0.1:8080
